<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="MQTTnet" Version="5.0.1.1416" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.10.3" />
    <!-- Pin transitive packages to versions that patch known security advisories
         (GHSA-v5pm-xwqc-g5wc in Microsoft.OpenApi, GHSA-2m69-gcr7-jv3q in SQLitePCLRaw). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoombaNet.Core\RoombaNet.Core.csproj" />
    <ProjectReference Include="..\RoombaNet.Settings\RoombaNet.Settings.csproj" />
  </ItemGroup>

</Project>
